<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqls PUBLIC "-//PAOHAIJIAO//DTD API SQLS 1.0//EN"
        "classpath:paohaijiao/dtd/Jquick-sql.dtd">
<sqls namespace="com.github.paohaijiao.xml.dao.DataDao">
    <sql name="selectData" returnClass="com.github.paohaijiao.xml.model.DataStatistics">
       select *  from data_catalog_stat where 1=1
        <if test="null!=level">
           and level ='#{level}'
        </if>
        <if test="null!=startDate">
            and  create_date>#{startDate}
        </if>
        <if test="null!=endDate">
            and  createdate &lt;#{endDate}::'yyyy-MM-dd HH:mm:ss'
        </if>
    </sql>
    <sql name="selectDataBean" returnClass="com.github.paohaijiao.xml.model.DataStatistics">
        select *  from data_catalog_stat where 1=1
        <if test="null!=level">
            and level ='#{level}'
        </if>
        <if test="null!=startDate">
            and  create_date>#{startDate}
        </if>
        <if test="null!=endDate">
            and  createdate &lt;#{endDate}::'yyyy-MM-dd HH:mm:ss'
        </if>
    </sql>
</sqls>